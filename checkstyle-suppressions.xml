<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>
    <!-- Suppress Javadoc requirements on test classes -->
    <suppress checks="JavadocMethod" files=".*Test\.java"/>
    <suppress checks="JavadocType" files=".*Test\.java"/>

    <!-- Suppress magic number check in test classes (test data) -->
    <suppress checks="MagicNumber" files=".*Test\.java"/>

    <!-- Suppress final parameters in test classes -->
    <suppress checks="FinalParameters" files=".*Test\.java"/>

    <!-- Suppress HiddenField for Lombok builder inner classes -->
    <suppress checks="HiddenField" files=".*Builder\.java"/>

    <!-- Suppress VisibilityModifier for DTO classes using Lombok -->
    <suppress checks="VisibilityModifier" files=".*dto.*\.java"/>
</suppressions>
